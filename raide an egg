-- Watchdog: إعادة التطبيق
-- ─────────────────────────
RunService.Heartbeat:Connect(function()
    if speedEnabled and hum and hum.WalkSpeed ~= AntiDetect.CurrentSpeed then
        -- الماب حاول يرجع السرعة، أعدها بهدوء
        local diff = AntiDetect.CurrentSpeed - hum.WalkSpeed
        if math.abs(diff) > 2 then
            hum.WalkSpeed = hum.WalkSpeed + (diff * 0.3)
        else
            hum.WalkSpeed = AntiDetect.CurrentSpeed
        end
    end
end)

