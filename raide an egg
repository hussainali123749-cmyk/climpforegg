-- ═══════════════════════════
--   CONFIG
-- ═══════════════════════════
local CFG = {
    TargetSpeed   = 28,     -- سرعتك المستهدفة
    DefaultSpeed  = 16,     -- سرعة الماب الافتراضية
    StepSize      = 0.4,    -- حجم الخطوة (كلما صغر كلما صعب الكشف)
    StepDelay     = 0.08,   -- تأخير بين كل خطوة
    ResetOnDeath  = true,
    SpoofValue    = 16,     -- القيمة المرئية للسيرفر
}

-- ═══════════════════════════
--   ANTI-DETECT ENGINE
-- ═══════════════════════════
local AntiDetect = {}
AntiDetect.Active = false
AntiDetect.CurrentSpeed = CFG.DefaultSpeed

-- تسريع تدريجي بدل القفز المباشر
function AntiDetect:RampUp(target)
    self.Active = true
    local current = hum.WalkSpeed
    local steps = math.floor((target - current) / CFG.StepSize)
    
    for i = 1, steps do
        if not self.Active then break end
        hum.WalkSpeed = current + (CFG.StepSize * i)
        task.wait(CFG.StepDelay)
    end
    hum.WalkSpeed = target
    self.CurrentSpeed = target
end

function AntiDetect:RampDown()
    self.Active = false
    local current = hum.WalkSpeed
    local steps = math.floor((current - CFG.DefaultSpeed) / CFG.StepSize)
    
    for i = 1, steps do
        hum.WalkSpeed = current - (CFG.StepSize * i)
        task.wait(CFG.StepDelay / 2)
    end
    hum.WalkSpeed = CFG.DefaultSpeed
    self.CurrentSpeed = CFG.DefaultSpeed
end

-- حماية من الـ property watchers
local mt = getrawmetatable and getrawmetatable(game)
if mt then
    local old_index = mt.__index
    local old_newindex = mt.__newindex
    
    local success = pcall(function()
        setreadonly(mt, false)
        mt.__newindex = function(t, k, v)
            if k == "WalkSpeed" then
                -- أرسل للسيرفر القيمة الافتراضية
                return old_newindex(t, k, CFG.SpoofValue)
            end
            return old_newindex(t, k, v)
        end
        setreadonly(mt, true)
    end)
end

-- ═══════════════════════════
--   CHARACTER HANDLER
-- ═══════════════════════════
local function onCharacter(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    
    if CFG.ResetOnDeath then
        hum.Died:Connect(function()
            AntiDetect.Active = false
            AntiDetect.CurrentSpeed = CFG.DefaultSpeed
        end)
    end
    
    -- أعد تطبيق السرعة بعد الموت
    player.CharacterAdded:Connect(function(c)
        task.wait(1.5)
        if AntiDetect.Active then
            char = c
            hum = c:WaitForChild("Humanoid")
            AntiDetect:RampUp(CFG.TargetSpeed)
        end
    end)
end

player.CharacterAdded:Connect(onCharacter)

