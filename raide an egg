-- Slider Logic
local dragging = false
local minSpeed, maxSpeed = 16, 60

SliderHandle.TouchStarted:Connect(function()
    dragging = true
end)

SliderHandle.TouchEnded:Connect(function()
    dragging = false
end)

UserInputService.TouchMoved:Connect(function(touch)
    if dragging then
        local trackPos = SliderTrack.AbsolutePosition.X
        local trackSize = SliderTrack.AbsoluteSize.X
        local relX = math.clamp((touch.Position.X - trackPos) / trackSize, 0, 1)
        
        SliderFill.Size = UDim2.new(relX, 0, 1, 0)
        SliderHandle.Position = UDim2.new(relX, -9, 0.5, -9)
        
        CFG.TargetSpeed = math.floor(minSpeed + relX * (maxSpeed - minSpeed))
        SpeedValue.Text = tostring(CFG.TargetSpeed)
        
        if AntiDetect.Active then
            hum.WalkSpeed = CFG.TargetSpeed
            AntiDetect.CurrentSpeed = CFG.TargetSpeed
        end
    end
end)

