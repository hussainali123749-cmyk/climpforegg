-- ══════════════════════════
--  DRAG LOGIC
-- ══════════════════════════
local dragging = false
local dragStart = Vector2.new()
local frameStart = UDim2.new()

local function startDrag(x, y)
    dragging   = true
    dragStart  = Vector2.new(x, y)
    frameStart = Main.Position
end

local function moveDrag(x, y)
    if not dragging then return end
    local dx = x - dragStart.X
    local dy = y - dragStart.Y
    Main.Position = UDim2.new(
        frameStart.X.Scale, frameStart.X.Offset + dx,
        frameStart.Y.Scale, frameStart.Y.Offset + dy
    )
end

local function endDrag() dragging = false end

-- Touch
Header.TouchStarted:Connect(function(t)  startDrag(t.Position.X, t.Position.Y) end)
Header.TouchEnded:Connect(endDrag)
UIS.TouchMoved:Connect(function(t)
    if dragging then moveDrag(t.Position.X, t.Position.Y) end
end)

-- Mouse fallback
Header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        startDrag(Mouse.X, Mouse.Y)
    end
end)
UIS.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement then
        moveDrag(Mouse.X, Mouse.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then endDrag() end
end)

-- ══════════════════════════
--  SLIDER LOGIC
-- ══════════════════════════
local sDrag = false

local function calcSpeed(inputX)
    local tX   = Track.AbsolutePosition.X
    local tW   = Track.AbsoluteSize.X
    local relX = math.clamp((inputX - tX) / tW, 0, 1)
    Fill.Size              = UDim2.new(relX, 0, 1, 0)
    Handle.Position        = UDim2.new(relX, -10, 0.5, -10)
    local spd = math.floor(CFG.MinSpeed + relX * (CFG.MaxSpeed - CFG.MinSpeed))
    CFG.TargetSpeed        = spd
    SVal.Text              = tostring(spd)
    if CFG.Enabled then
        StatusTxt.Text = "ACTIVE  ·  " .. spd .. " studs/s"
    end
end

Track.TouchStarted:Connect(function(t)  sDrag = true; calcSpeed(t.Position.X) end)
Handle.TouchStarted:Connect(function()  sDrag = true end)
Track.TouchEnded:Connect(function()     sDrag = false end)
Handle.TouchEnded:Connect(function()    sDrag = false end)

UIS.TouchMoved:Connect(function(t)
    if sDrag then calcSpeed(t.Position.X) end
end)

Track.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        sDrag = true; calcSpeed(Mouse.X)
    end
end)
UIS.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement and sDrag then
        calcSpeed(Mouse.X)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then sDrag = false end
end)

