-- ══════════════════════════
--  SPEED ENGINE
-- ══════════════════════════
local function setSpeed(v)
    if Hum then Hum.WalkSpeed = v end
end

RunService.Heartbeat:Connect(function()
    if CFG.Enabled and Hum then
        if math.abs(Hum.WalkSpeed - CFG.TargetSpeed) > 1 then
            Hum.WalkSpeed = Hum.WalkSpeed +
                (CFG.TargetSpeed - Hum.WalkSpeed) * 0.15
        else
            Hum.WalkSpeed = CFG.TargetSpeed
        end
    end
end)

LP.CharacterAdded:Connect(function(c)
    Char = c
    Hum  = c:WaitForChild("Humanoid")
    if CFG.Enabled then
        task.wait(1.2)
        setSpeed(CFG.TargetSpeed)
    end
end)

