-- ══ SAVE TO FILE ══
local function saveToFile(data)
    local filename = "map_analysis_" .. tostring(data.map_id) .. "_" .. tostring(os.time()) .. ".txt"
    
    local content = "═══════════════════════════════════════\n"
    content = content .. "ROBLOX MAP ANALYSIS REPORT\n"
    content = content .. "═══════════════════════════════════════\n"
    content = content .. "Map Name: " .. tostring(data.map_name) .. "\n"
    content = content .. "Place ID: " .. tostring(data.map_id) .. "\n"
    content = content .. "Universe ID: " .. tostring(data.universe_id) .. "\n"
    content = content .. "Analysis Time: " .. os.date("%Y-%m-%d %H:%M:%S", data.analysis_time) .. "\n"
    content = content .. "\n"

    -- Concept
    content = content .. "── CONCEPT ──\n"
    content = content .. tableToString(data.concept, 1)
    content = content .. "\n"

    -- Gameplay
    content = content .. "── GAMEPLAY ──\n"
    content = content .. tableToString(data.gameplay, 1)
    content = content .. "\n"

    -- Speed System
    content = content .. "── SPEED / CHARACTER SYSTEM ──\n"
    content = content .. tableToString(data.speed_system, 1)
    content = content .. "\n"

    -- Physics
    content = content .. "── PHYSICS ──\n"
    content = content .. tableToString(data.physics, 1)
    content = content .. "\n"

    -- Lighting / Rendering
    content = content .. "── LIGHTING ──\n"
    content = content .. tableToString(data.lighting, 1)
    content = content .. "\n"

    content = content .. "── RENDERING ──\n"
    content = content .. tableToString(data.rendering, 1)
    content = content .. "\n"

    -- Protection
    content = content .. "── PROTECTION / ANTI-CHEAT ──\n"
    content = content .. tableToString(data.protection, 1)
    content = content .. "\n"
    content = content .. "Anti-Cheat Objects Found: " .. tostring(#data.anti_cheat) .. "\n"
    for i, ac in ipairs(data.anti_cheat) do
        content = content .. "  [" .. i .. "] " .. tostring(ac.name) .. " (" .. tostring(ac.class) .. ") @ " .. tostring(ac.path) .. "\n"
    end
    content = content .. "\n"

    -- Remotes
    content = content .. "── REMOTE EVENTS / FUNCTIONS ──\n"
    content = content .. "Count: " .. tostring(#data.remotes) .. "\n"
    for i, r in ipairs(data.remotes) do
        content = content .. "  [" .. i .. "] " .. tostring(r.type) .. " | " .. tostring(r.name) .. " @ " .. tostring(r.path) .. "\n"
    end
    content = content .. "\n"

    -- Shop
    content = content .. "── SHOP / ECONOMY SYSTEM ──\n"
    content = content .. "Objects Found: " .. tostring(#data.shop_system) .. "\n"
    for i, s in ipairs(data.shop_system) do
        content = content .. "  [" .. i .. "] " .. tostring(s.name) .. " (" .. tostring(s.class) .. ")"
        if s.value then content = content .. " = " .. tostring(s.value) end
        content = content .. "\n"
    end
    content = content .. "\n"

    -- Scripts
    content = content .. "── SCRIPTS FOUND ──\n"
    content = content .. "Count: " .. tostring(#data.scripts_found) .. "\n"
    for i, sc in ipairs(data.scripts_found) do
        content = content .. "  [" .. i .. "] " .. tostring(sc.class) .. " | " .. tostring(sc.name)
        if sc.disabled then content = content .. " [DISABLED]" end
        content = content .. " @ " .. tostring(sc.path) .. "\n"
    end
    content = content .. "\n"

    -- Values
    content = content .. "── VALUES (Game Data) ──\n"
    content = content .. "Count: " .. tostring(#data.values) .. "\n"
    for i, v in ipairs(data.values) do
        content = content .. "  [" .. i .. "] " .. tostring(v.name) .. " (" .. tostring(v.class) .. ") = " .. tostring(v.value) .. "\n"
    end
    content = content .. "\n"

    -- NPCs
    content = content .. "── NPCs ──\n"
    content = content .. "Count: " .. tostring(#data.npcs) .. "\n"
    for i, n in ipairs(data.npcs) do
        content = content .. "  [" .. i .. "] " .. tostring(n.name) .. " | HP: " .. tostring(n.health) .. "/" .. tostring(n.max_health) .. " | Speed: " .. tostring(n.walk_speed) .. "\n"
    end
    content = content .. "\n"

    -- GUI
    content = content .. "── GUI ELEMENTS ──\n"
    for i, g in ipairs(data.gui_elements) do
        content = content .. "  [" .. i .. "] " .. tostring(g.name) .. " (" .. tostring(g.class) .. ")\n"
    end
    content = content .. "\n"

    -- Sounds
    content = content .. "── SOUNDS ──\n"
    content = content .. "Count: " .. tostring(#data.sounds) .. "\n"
    for i, s in ipairs(data.sounds) do
        content = content .. "  [" .. i .. "] " .. tostring(s.name) .. " | ID: " .. tostring(s.id) .. " | Vol: " .. tostring(s.volume) .. "\n"
    end
    content = content .. "\n"

    content = content .. "═══════════════════════════════════════\n"
    content = content .. "END OF REPORT\n"
    content = content .. "═══════════════════════════════════════\n"

    -- Write file (Delta supports writefile)
    local ok, err = pcall(function()
        writefile(filename, content)
    end)

    if ok then
        -- Notify in game
        local StarterGui = game:GetService("StarterGui")
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Analysis Complete",
                Text = "Saved: " .. filename,
                Duration = 8
            })
        end)
        print("[ANALYZER] File saved: " .. filename)
    else
        print("[ANALYZER] Save failed: " .. tostring(err))
    end

    return filename
end

