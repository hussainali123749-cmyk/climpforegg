-- ══ MAP IDENTITY ══
function Analyzer:getMapIdentity()
    local info = safeCall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    self.data.map_name = safeGet(game, "Name") or "Unknown"
    self.data.map_id = safeGet(game, "PlaceId") or 0
    self.data.universe_id = safeGet(game, "GameId") or 0
    if info then
        self.data.concept.title = info.Name or ""
        self.data.concept.description = info.Description or ""
        self.data.concept.creator = info.Creator and info.Creator.Name or ""
        self.data.concept.price = info.PriceInRobux or 0
    end
end

-- ══ GAMEPLAY ANALYSIS ══
function Analyzer:analyzeGameplay()
    local players = game:GetService("Players")
    local lp = players.LocalPlayer

    self.data.gameplay.player_count = #players:GetPlayers()
    self.data.gameplay.max_players = safeGet(game, "MaxPlayers") or 0
    self.data.gameplay.respawn_time = safeGet(players, "RespawnTime") or 0

    -- Character analysis
    local char = lp and lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            self.data.speed_system.walk_speed = safeGet(hum, "WalkSpeed") or 16
            self.data.speed_system.jump_power = safeGet(hum, "JumpPower") or 50
            self.data.speed_system.jump_height = safeGet(hum, "JumpHeight") or 7.2
            self.data.speed_system.max_health = safeGet(hum, "MaxHealth") or 100
            self.data.speed_system.health = safeGet(hum, "Health") or 100
            self.data.speed_system.hipheight = safeGet(hum, "HipHeight") or 1.35
        end
    end

    -- Teams
    local teams = safeCall(function() return game:GetService("Teams") end)
    if teams then
        local teamList = {}
        for _, team in ipairs(teams:GetChildren()) do
            table.insert(teamList, {
                name = safeGet(team, "Name"),
                color = tostring(safeGet(team, "TeamColor")),
                auto_assign = safeGet(team, "AutoAssignable")
            })
        end
        self.data.gameplay.teams = teamList
    end
end

-- ══ REMOTE EVENTS / FUNCTIONS (gameplay signals) ══
function Analyzer:analyzeRemotes()
    local rs = safeCall(function() return game:GetService("ReplicatedStorage") end)
    if not rs then return end

    local function scanForRemotes(parent, path)
        path = path or ""
        for _, obj in ipairs(parent:GetChildren()) do
            local class = safeGet(obj, "ClassName")
            local name = safeGet(obj, "Name") or "?"
            local fullPath = path .. "/" .. name

            if class == "RemoteEvent" or class == "RemoteFunction" or class == "BindableEvent" then
                table.insert(self.data.remotes, {
                    name = name,
                    type = class,
                    path = fullPath
                })
            end
            -- recurse
            safeCall(function() scanForRemotes(obj, fullPath) end)
        end
    end

    scanForRemotes(rs, "ReplicatedStorage")

    -- Also check workspace remotes
    safeCall(function() scanForRemotes(workspace, "Workspace") end)
end

-- ══ SHOP SYSTEM DETECTION ══
function Analyzer:detectShopSystem()
    local keywords = {
        "shop","store","buy","purchase","market","mall",
        "coin","gem","cash","currency","robux","credit",
        "item","weapon","skin","pet","gamepass","product"
    }

    local function searchNode(parent, depth)
        if depth > 5 then return end
        for _, obj in ipairs(parent:GetDescendants and parent:GetDescendants() or {}) do
            local name = string.lower(safeGet(obj, "Name") or "")
            for _, kw in ipairs(keywords) do
                if name:find(kw) then
                    local entry = {
                        name = safeGet(obj, "Name"),
                        class = safeGet(obj, "ClassName"),
                        path = obj:GetFullName and obj:GetFullName() or "unknown"
                    }
                    -- check for values
                    if obj:IsA and obj:IsA("IntValue") or obj:IsA and obj:IsA("NumberValue") then
                        entry.value = safeGet(obj, "Value")
                    end
                    table.insert(self.data.shop_system, entry)
                    break
                end
            end
        end
    end

    safeCall(function() searchNode(game:GetService("ReplicatedStorage"), 0) end)
    safeCall(function() searchNode(workspace, 0) end)
    safeCall(function() searchNode(game:GetService("Players").LocalPlayer, 0) end)
end

-- ══ PROTECTION / ANTI-CHEAT DETECTION ══
function Analyzer:detectProtection()
    -- Scan for known anti-cheat patterns
    local acKeywords = {
        "anticheat","anti_cheat","ac","detection","kick","ban",
        "exploit","cheat","hack","integrity","verify","validate",
        "checkspeed","speedcheck","flycheck","teleportcheck"
    }

    local function scanAC(parent)
        local ok, children = pcall(function() return parent:GetDescendants() end)
        if not ok then return end
        for _, obj in ipairs(children) do
            local name = string.lower(safeGet(obj, "Name") or "")
            local class = safeGet(obj, "ClassName") or ""
            for _, kw in ipairs(acKeywords) do
                if name:find(kw) then
                    table.insert(self.data.anti_cheat, {
                        name = safeGet(obj, "Name"),
                        class = class,
                        path = obj:GetFullName and obj:GetFullName() or "?"
                    })
                    break
                end
            end
        end
    end

    safeCall(function() scanAC(game:GetService("ReplicatedStorage")) end)
    safeCall(function() scanAC(workspace) end)

    -- ServerScriptService is inaccessible client-side but we flag if visible
    local sss = safeCall(function() return game:GetService("ServerScriptService") end)
    if sss then
        local ok, kids = pcall(function() return sss:GetChildren() end)
        if ok and #kids > 0 then
            self.data.protection.sss_accessible = true
            self.data.protection.sss_children = #kids
        else
            self.data.protection.sss_accessible = false
        end
    end

    -- Check for FilteringEnabled
    self.data.protection.filtering_enabled = safeGet(workspace, "FilteringEnabled")

    -- StreamingEnabled
    self.data.protection.streaming_enabled = safeGet(workspace, "StreamingEnabled")
end

-- ══ RENDERING / VISUAL ANALYSIS ══
function Analyzer:analyzeRendering()
    local lighting = safeCall(function() return game:GetService("Lighting") end)
    if lighting then
        self.data.lighting = {
            brightness = safeGet(lighting, "Brightness"),
            ambient = tostring(safeGet(lighting, "Ambient")),
            outdoor_ambient = tostring(safeGet(lighting, "OutdoorAmbient")),
            time_of_day = safeGet(lighting, "TimeOfDay"),
            fog_end = safeGet(lighting, "FogEnd"),
            fog_start = safeGet(lighting, "FogStart"),
            fog_color = tostring(safeGet(lighting, "FogColor")),
            effects = {}
        }
        for _, effect in ipairs(lighting:GetChildren()) do
            table.insert(self.data.lighting.effects, {
                name = safeGet(effect, "Name"),
                class = safeGet(effect, "ClassName")
            })
        end
    end

    -- Terrain
    local terrain = safeGet(workspace, "Terrain")
    if terrain then
        self.data.terrain = {
            material_count = 0,
            water_level = safeGet(terrain, "WaterLevel"),
            decoration = safeGet(terrain, "Decoration")
        }
    end

    -- Part count
    local partCount = 0
    local meshCount = 0
    local unionCount = 0
    safeCall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            local c = safeGet(obj, "ClassName")
            if c == "Part" or c == "WedgePart" or c == "CornerWedgePart" then
                partCount = partCount + 1
            elseif c == "MeshPart" or c == "SpecialMesh" then
                meshCount = meshCount + 1
            elseif c == "UnionOperation" then
                unionCount = unionCount + 1
            end
        end
    end)
    self.data.rendering.part_count = partCount
    self.data.rendering.mesh_count = meshCount
    self.data.rendering.union_count = unionCount
end

-- ══ SCRIPTS SCAN ══
function Analyzer:scanScripts()
    local function findScripts(parent)
        local ok, children = pcall(function() return parent:GetDescendants() end)
        if not ok then return end
        for _, obj in ipairs(children) do
            local class = safeGet(obj, "ClassName")
            if class == "LocalScript" or class == "Script" or class == "ModuleScript" then
                table.insert(self.data.scripts_found, {
                    name = safeGet(obj, "Name"),
                    class = class,
                    path = obj:GetFullName and obj:GetFullName() or "?",
                    disabled = safeGet(obj, "Disabled")
                })
            end
        end
    end
    safeCall(function() findScripts(game:GetService("ReplicatedStorage")) end)
    safeCall(function() findScripts(workspace) end)
    safeCall(function() findScripts(game:GetService("StarterGui")) end)
    safeCall(function() findScripts(game:GetService("Players").LocalPlayer) end)
end

-- ══ VALUES SCAN (game data) ══
function Analyzer:scanValues()
    local function findValues(parent)
        local ok, children = pcall(function() return parent:GetDescendants() end)
        if not ok then return end
        for _, obj in ipairs(children) do
            local class = safeGet(obj, "ClassName")
            if class == "IntValue" or class == "NumberValue" or 
               class == "StringValue" or class == "BoolValue" then
                table.insert(self.data.values, {
                    name = safeGet(obj, "Name"),
                    class = class,
                    value = safeGet(obj, "Value"),
                    path = obj:GetFullName and obj:GetFullName() or "?"
                })
            end
        end
    end
    safeCall(function() findValues(game:GetService("Players").LocalPlayer) end)
    safeCall(function() findValues(workspace) end)
end

-- ══ NPCs ══
function Analyzer:scanNPCs()
    safeCall(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local isPlayer = false
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p.Character == obj then isPlayer = true; break end
            end
            if hum and not isPlayer then
                table.insert(self.data.npcs, {
                    name = safeGet(obj, "Name"),
                    health = safeGet(hum, "Health"),
                    max_health = safeGet(hum, "MaxHealth"),
                    walk_speed = safeGet(hum, "WalkSpeed"),
                    has_pathfinding = obj:FindFirstChildOfClass("PathfindingLink") ~= nil
                })
            end
        end
    end)
end

