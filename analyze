    local pg = safeCall(function()
        return game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end)

    local function scanGui(parent)
        if not parent then return end
        local ok, children = pcall(function() return parent:GetChildren() end)
        if not ok then return end
        for _, obj in ipairs(children) do
            table.insert(self.data.gui_elements, {
                name = safeGet(obj, "Name"),
                class = safeGet(obj, "ClassName")
            })
        end
    end
    scanGui(sg)
    scanGui(pg)
end

