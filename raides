-- ══════════════════════════
--  RAW TOUCH DETECTION
--  كل الـ touch يمر من هنا
-- ══════════════════════════
local function getAbsRect(frame)
    local p = frame.AbsolutePosition
    local s = frame.AbsoluteSize
    return {
        x1 = p.X, y1 = p.Y,
        x2 = p.X + s.X,
        y2 = p.Y + s.Y
    }
end

local function inside(rect, x, y)
    return x >= rect.x1 and x <= rect.x2
       and y >= rect.y1 and y <= rect.y2
end

-- State
local dragActive  = false
local dragStartV  = Vector2.new()
local dragFrameP  = UDim2.new()
local sliderActive = false
local isMinimized = false

-- ══════════════════════════
--  TOGGLE VISUAL
-- ══════════════════════════
local function applyToggle()
    if CFG.Enabled then
        TBTxt.Text               = "ON"
        TBTxt.TextColor3         = Color3.fromRGB(80, 255, 120)
        TBadge.BackgroundColor3  = Color3.fromRGB(15, 45, 22)
        TLab.TextColor3          = Color3.fromRGB(80, 255, 120)
        Dot.BackgroundColor3     = Color3.fromRGB(80, 255, 120)
        StatTxt.Text             = "ACTIVE  ·  "..CFG.TargetSpeed.." studs/s"
        TweenService:Create(TogFrame, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(14, 36, 18)
        }):Play()
    else
        TBTxt.Text               = "OFF"
        TBTxt.TextColor3         = Color3.fromRGB(120, 120, 140)
        TBadge.BackgroundColor3  = Color3.fromRGB(38, 38, 58)
        TLab.TextColor3          = Color3.fromRGB(200, 200, 220)
        Dot.BackgroundColor3     = Color3.fromRGB(70, 70, 90)
        StatTxt.Text             = "OFFLINE  ·  16 studs/s"
        TweenService:Create(TogFrame, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(20, 20, 34)
        }):Play()
        if Hum then Hum.WalkSpeed = 16 end
    end
end

-- ══════════════════════════
--  SLIDER CALC
-- ══════════════════════════
local function calcSlider(touchX)
    local tX  = Track.AbsolutePosition.X
    local tW  = Track.AbsoluteSize.X
    if tW == 0 then return end
    local rel = math.clamp((touchX - tX) / tW, 0, 1)
    Fill.Size       = UDim2.new(rel, 0, 1, 0)
    Handle.Position = UDim2.new(rel, -11, 0.5, -11)
    local spd = math.floor(CFG.MinSpeed + rel * (CFG.MaxSpeed - CFG.MinSpeed))
    CFG.TargetSpeed = spd
    SNum.Text       = tostring(spd)
    if CFG.Enabled then
        StatTxt.Text = "ACTIVE  ·  "..spd.." studs/s"
    end
end

-- ══════════════════════════
--  TOUCH BEGAN
-- ══════════════════════════
UIS.TouchStarted:Connect(function(touch, _gameProc)
    local x, y = touch.Position.X, touch.Position.Y

    -- CLOSE
    local cr = getAbsRect(CloseBtn)
    if inside(cr, x, y) then
        CFG.Enabled = false
        if Hum then Hum.WalkSpeed = 16 end
        SG:Destroy()
        return
    end

    -- MINIMIZE
    local mr = getAbsRect(MinBtn)
    if inside(mr, x, y) then
        isMinimized = not isMinimized
        TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Size = isMinimized
                and UDim2.new(0, 265, 0, 50)
                or  UDim2.new(0, 265, 0, 290)
        }):Play()
        MinTxt.Text = isMinimized and "□" or "−"
        return
    end

    -- TOGGLE
    local tr = getAbsRect(TogFrame)
    if inside(tr, x, y) then
        CFG.Enabled = not CFG.Enabled
        applyToggle()
        return
    end

    -- SLIDER (Track + Handle منطقة موسعة)
    local sr = getAbsRect(SBox)
    if inside(sr, x, y) then
        sliderActive = true
        calcSlider(x)
        return
    end

    -- DRAG (Header)
    local hr = getAbsRect(Header)
    if inside(hr, x, y) then
        dragActive  = true
        dragStartV  = Vector2.new(x, y)
        dragFrameP  = Main.Position
        return
    end
end)

-- ══════════════════════════
--  TOUCH MOVED
-- ══════════════════════════
UIS.TouchMoved:Connect(function(touch, _)
    local x, y = touch.Position.X, touch.Position.Y

    if sliderActive then
        calcSlider(x)
        return
    end

    if dragActive then
        local dx = x - dragStartV.X
        local dy = y - dragStartV.Y
        Main.Position = UDim2.new(
            dragFrameP.X.Scale, dragFrameP.X.Offset + dx,
            dragFrameP.Y.Scale, dragFrameP.Y.Offset + dy
        )
    end
end)

-- ══════════════════════════
--  TOUCH ENDED
-- ══════════════════════════
UIS.TouchEnded:Connect(function(_, _)
    dragActive   = false
    sliderActive = false
end)

