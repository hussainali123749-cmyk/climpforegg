local content = table.concat(lines, "\n")

-- ══ SAVE TO DOWNLOADS ══
local filename = "map_analysis_" .. tostring(D.map_id) .. "_" .. tostring(os.time()) .. ".txt"
local fullPath = "/sdcard/Download/" .. filename

-- escape content for shell
local escaped = content:gsub("'", "'\\''")

local saveOk = false
local saveErr = ""

-- method 1: os.execute with shell redirect
local ok1 = pcall(function()
    os.execute("echo '" .. escaped .. "' > " .. fullPath)
    saveOk = true
end)

-- method 2: if method 1 failed try sh -c
if not saveOk then
    local ok2 = pcall(function()
        os.execute("sh -c \"echo '" .. escaped .. "' > " .. fullPath .. "\"")
        saveOk = true
    end)
end

-- method 3: writefile fallback
if not saveOk then
    local ok3, err3 = pcall(function()
        writefile(filename, content)
        saveOk = true
        fullPath = filename .. " (Delta folder)"
    end)
    if not ok3 then saveErr = tostring(err3) end
end

-- ══ FINAL STATUS ══
if saveOk then
    setStatus("✅ تم الحفظ!", fullPath)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "✅ تم التحليل",
            Text = filename,
            Duration = 10
        })
    end)
else
    setStatus("❌ فشل الحفظ", saveErr:sub(1,80))
end

