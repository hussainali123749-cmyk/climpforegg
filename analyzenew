-- ══ GUI ══
local function createGUI()
    pcall(function()
        local old = LocalPlayer.PlayerGui:FindFirstChild("AnalyzerGUI")
        if old then old:Destroy() end
    end)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "AnalyzerGUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = LocalPlayer.PlayerGui

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 300, 0, 100)
    Frame.Position = UDim2.new(0.5, -150, 0, 20)
    Frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui

    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

    local Bar = Instance.new("Frame")
    Bar.Size = UDim2.new(1, 0, 0, 30)
    Bar.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    Bar.BorderSizePixel = 0
    Bar.Parent = Frame
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 10)

    local TitleL = Instance.new("TextLabel")
    TitleL.Size = UDim2.new(1, 0, 1, 0)
    TitleL.BackgroundTransparency = 1
    TitleL.Text = "⚡ MAP ANALYZER"
    TitleL.TextColor3 = Color3.fromRGB(0, 0, 0)
    TitleL.TextSize = 14
    TitleL.Font = Enum.Font.GothamBold
    TitleL.Parent = Bar

    local Status = Instance.new("TextLabel")
    Status.Name = "Status"
    Status.Size = UDim2.new(1, -10, 0, 35)
    Status.Position = UDim2.new(0, 5, 0, 32)
    Status.BackgroundTransparency = 1
    Status.Text = "⏳ جاري التحليل..."
    Status.TextColor3 = Color3.fromRGB(220, 220, 220)
    Status.TextSize = 12
    Status.Font = Enum.Font.Gotham
    Status.TextXAlignment = Enum.TextXAlignment.Left
    Status.TextWrapped = true
    Status.Parent = Frame

    local Sub = Instance.new("TextLabel")
    Sub.Name = "Sub"
    Sub.Size = UDim2.new(1, -10, 0, 25)
    Sub.Position = UDim2.new(0, 5, 0, 68)
    Sub.BackgroundTransparency = 1
    Sub.Text = ""
    Sub.TextColor3 = Color3.fromRGB(150, 150, 150)
    Sub.TextSize = 10
    Sub.Font = Enum.Font.Gotham
    Sub.TextXAlignment = Enum.TextXAlignment.Left
    Sub.Parent = Frame

    return ScreenGui, Status, Sub
end

local gui, statusL, subL = createGUI()

local function setStatus(msg, sub)
    pcall(function()
        statusL.Text = msg
        subL.Text = sub or ""
    end)
end

local function closeGUI(delay)
    task.wait(delay or 6)
    pcall(function() gui:Destroy() end)
end

-- ══ UTILITIES ══
local function safeGet(obj, prop)
    local ok, v = pcall(function() return obj[prop] end)
    return ok and v or nil
end

local function safeCall(f, ...)
    local ok, r = pcall(f, ...)
    return ok and r or nil
end

