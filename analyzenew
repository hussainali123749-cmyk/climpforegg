-- 6) remotes
setStatus("⏳ الـ Remotes", "")
task.wait(0.3)
local function scanRemotes(parent)
    local ok, desc = pcall(function() return parent:GetDescendants() end)
    if not ok then return end
    for _, o in ipairs(desc) do
        local c = safeGet(o, "ClassName")
        if c == "RemoteEvent" or c == "RemoteFunction" or c == "BindableEvent" then
            table.insert(D.remotes, {
                name = safeGet(o,"Name"),
                type = c,
                path = o:GetFullName and o:GetFullName() or "?"
            })
        end
    end
end
safeCall(function() scanRemotes(game:GetService("ReplicatedStorage")) end)
safeCall(function() scanRemotes(workspace) end)

