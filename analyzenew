local parts, meshes, unions = 0, 0, 0
safeCall(function()
    for _, o in ipairs(workspace:GetDescendants()) do
        local c = safeGet(o, "ClassName")
        if c == "Part" or c == "WedgePart" or c == "CornerWedgePart" then
