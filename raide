-- ══════════════════════════════════════
--  SLIDER LOGIC (حقيقي للموبايل)
-- ══════════════════════════════════════
local sliderDragging = false

local function updateSlider(inputX)
    local trackPos = Track.AbsolutePosition.X
    local trackSize = Track.AbsoluteSize.X
    local relX = math.clamp((inputX - trackPos) / trackSize, 0, 1)
    
    Fill.Size = UDim2.new(relX, 0, 1, 0)
    Handle.Position = UDim2.new(relX, -11, 0.5, -11)
    
    local speed = math.floor(Settings.MinSpeed + relX * (Settings.MaxSpeed - Settings.MinSpeed))
    Settings.TargetSpeed = speed
    SpeedNum.Text = tostring(speed)
    
    if Settings.Enabled then
        Hum.WalkSpeed = speed
        StatusTxt.Text = "ACTIVE  —  " .. speed .. " studs/s"
    end
end

Track.TouchStarted:Connect(function(touch)
    sliderDragging = true
    updateSlider(touch.Position.X)
end)

Handle.TouchStarted:Connect(function(touch)
    sliderDragging = true
end)

Track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
        updateSlider(Mouse.X)
    end
end)

UIS.TouchMoved:Connect(function(touch)
    if sliderDragging then
        updateSlider(touch.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if sliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(Mouse.X)
    end
end)

UIS.TouchEnded:Connect(function()
    sliderDragging = false
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = false
    end
end)

