        TweenService:Create(SpeedToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(20, 50, 30)
        }):Play()
        
        Engine.Running = false
        task.wait(0.05)
        task.spawn(function()
            Engine:Apply(Settings.TargetSpeed)
        end)
    else
        -- OFF
        ToggleState.Text = "OFF"
