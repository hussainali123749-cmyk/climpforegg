        ToggleState.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        ToggleLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
        StatusTxt.Text = "OFFLINE  —  16 studs/s"
        
        TweenService:Create(SpeedToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(20, 20, 35)
        }):Play()
        
        Engine:Reset()
    end
end)

