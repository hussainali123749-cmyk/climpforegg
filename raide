local dragging = false
local dragStartPos = Vector2.new()
local frameStartPos = UDim2.new()

DragBar.TouchStarted:Connect(function(touch)
    dragging = true
    dragStartPos = Vector2.new(touch.Position.X, touch.Position.Y)
    frameStartPos = Main.Position
end)

DragBar.TouchEnded:Connect(function()
    dragging = false
end)

UIS.TouchMoved:Connect(function(touch)
    if dragging then
        local delta = Vector2.new(
            touch.Position.X - dragStartPos.X,
            touch.Position.Y - dragStartPos.Y
        )
        Main.Position = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
    end
end)

-- Drag بالماوس للـ PC أيضاً
DragBar.MouseButton1Down:Connect(function()
    dragging = true
    dragStartPos = Vector2.new(Mouse.X, Mouse.Y)
    frameStartPos = Main.Position
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = Vector2.new(
            Mouse.X - dragStartPos.X,
            Mouse.Y - dragStartPos.Y
        )
        Main.Position = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

