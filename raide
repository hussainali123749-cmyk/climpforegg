--  SETTINGS
-- ══════════════════════════════════════
local Settings = {
    MinSpeed    = 16,
    MaxSpeed    = 80,
    TargetSpeed = 30,
    StepSize    = 0.5,
    StepDelay   = 0.06,
    Enabled     = false,
}

-- ══════════════════════════════════════
--  ANTI-DETECT ENGINE
-- ══════════════════════════════════════
local Engine = {}
Engine.Running = false

function Engine:Apply(target)
    self.Running = true
    local current = Hum.WalkSpeed
    local direction = target > current and 1 or -1
    
    while math.abs(Hum.WalkSpeed - target) > 0.5 and self.Running do
        Hum.WalkSpeed = Hum.WalkSpeed + (Settings.StepSize * direction)
        task.wait(Settings.StepDelay)
    end
    
    if self.Running then
        Hum.WalkSpeed = target
    end
end

function Engine:Reset()
    self.Running = false
    task.spawn(function()
        local current = Hum.WalkSpeed
        local steps = 12
        for i = 1, steps do
            Hum.WalkSpeed = current - ((current - Settings.MinSpeed) / steps * i)
            task.wait(0.04)
        end
        Hum.WalkSpeed = Settings.MinSpeed
    end)
end

-- Watchdog
RunService.Heartbeat:Connect(function()
    if Settings.Enabled and Hum then
        local diff = Settings.TargetSpeed - Hum.WalkSpeed
        if math.abs(diff) > 1.5 then
            Hum.WalkSpeed = Hum.WalkSpeed + (diff * 0.25)
        end
    end
end)

